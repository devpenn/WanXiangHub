<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.penn.myapplication.ui.home.HomeFragment"
        android:label="主页"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_tools"
        android:name="com.penn.myapplication.ui.tools.ToolsFragment"
        android:label="工具"
        tools:layout="@layout/fragment_tools" />

    <fragment
        android:id="@+id/navigation_todo"
        android:name="com.penn.myapplication.ui.todo.TodoFragment"
        android:label="TODO"
